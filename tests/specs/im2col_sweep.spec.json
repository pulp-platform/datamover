{
  "name": "im2col_sweep",
  "op": "im2col",
  "description": "LAYOUTS picks the datapath and holds the values it allows; a repeated entry gets more draws, which balances the paths with a low legal rate. The 5x5 and 7x7 entries draw only on a profile whose IM2COL_KERNEL holds them. The free axes draw the rest; the second constraint keeps the im2col output inside the transfer cap of the generator, so the draws are not lost to the cap. The image is at least one beat; kernels are square. The CHW paths draw CONV_PAD from 0 to K // 2; the engine makes the border. Two CHW entries hold a pad of K // 2, a small image, and a word-aligned row, so every profile draws a padded image with a large kernel. BEAT is the elements per beat of the profile.",
  "max_tests": 100,
  "seed": 1,
  "constraints": ["SIZE_M * SIZE_N >= BEAT", "SIZE_C * SIZE_M * SIZE_N * KERNEL_SIZE_H * KERNEL_SIZE_W <= 260000 * CONV_STRIDE * CONV_STRIDE"],
  "axes": {
    "KERNEL_SIZE_H": {"min": 1, "max": 7},
    "KERNEL_SIZE_W": "KERNEL_SIZE_H",
    "CONV_STRIDE": [1, 2],
    "CONV_PAD": [0, 1, 2, 3],
    "SIZE_C": {"min": 1, "max": 32},
    "SIZE_M": {"min": 1, "max": 512},
    "SIZE_N": {"min": 1, "max": 512},
    "LAYOUTS": [
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "COL", "CONV_PAD": "min(CONV_PAD, KERNEL_SIZE_H // 2)"},
      {"IM2COL_IN": "BLOCK", "IM2COL_OUT": "COL_BLOCK", "KERNEL_SIZE_H": [3, 5, 7], "CONV_STRIDE": 1, "CONV_PAD": "KERNEL_SIZE_H // 2", "SIZE_N": [8, 16, 32, 64, 128, 256], "SIZE_M": {"min": 8, "max": 512, "multiple_of": 8}},
      {"IM2COL_IN": "BLOCK", "IM2COL_OUT": "COL_BLOCK", "KERNEL_SIZE_H": [5, 7], "CONV_STRIDE": 1, "CONV_PAD": "KERNEL_SIZE_H // 2", "SIZE_N": [8, 16, 32, 64, 128, 256], "SIZE_M": {"min": 8, "max": 512, "multiple_of": 8}},
      {"IM2COL_IN": "BLOCK", "IM2COL_OUT": "COL_BLOCK", "KERNEL_SIZE_H": 3, "CONV_STRIDE": 1, "CONV_PAD": 1, "SIZE_N": [8, 16, 32, 64, 128, 256], "SIZE_M": {"min": 8, "max": 512, "multiple_of": 8}},
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "COL_BLOCK", "CONV_STRIDE": 2, "CONV_PAD": "min(CONV_PAD, KERNEL_SIZE_H // 2)", "SIZE_N": "max(SIZE_N - (SIZE_N + 2 * CONV_PAD - KERNEL_SIZE_H + 2) % (2 * BEAT), KERNEL_SIZE_H - 2 * CONV_PAD + 2 * BEAT - 2)"},
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "COL", "KERNEL_SIZE_H": [3, 5, 7], "CONV_PAD": "KERNEL_SIZE_H // 2", "SIZE_C": {"min": 1, "max": 4}, "SIZE_M": {"min": 1, "max": 64}, "SIZE_N": {"min": 8, "max": 512, "multiple_of": 8}},
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "COL_BLOCK", "CONV_STRIDE": 2, "KERNEL_SIZE_H": [3, 5, 7], "CONV_PAD": "KERNEL_SIZE_H // 2", "SIZE_C": {"min": 1, "max": 4}, "SIZE_M": {"min": 1, "max": 64}, "SIZE_N": "max(SIZE_N - (SIZE_N + 2 * CONV_PAD - KERNEL_SIZE_H + 1) % (2 * BEAT), KERNEL_SIZE_H - 2 * CONV_PAD + 2 * BEAT - 1)"},
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "ROW_BLOCK", "CONV_PAD": 0, "KERNEL_SIZE_H": [4, 8, 16, 32, 64], "CONV_STRIDE": "KERNEL_SIZE_H", "SIZE_M": "max(SIZE_M - SIZE_M % KERNEL_SIZE_H, KERNEL_SIZE_H)", "SIZE_N": "max(SIZE_N - SIZE_N % KERNEL_SIZE_H, KERNEL_SIZE_H)"},
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "ROW_BLOCK", "CONV_PAD": 0, "KERNEL_SIZE_H": [4, 8, 16, 32, 64], "CONV_STRIDE": "KERNEL_SIZE_H", "SIZE_M": "max(SIZE_M - SIZE_M % KERNEL_SIZE_H, KERNEL_SIZE_H)", "SIZE_N": "max(SIZE_N - SIZE_N % KERNEL_SIZE_H, KERNEL_SIZE_H)"},
      {"IM2COL_IN": "CHW", "IM2COL_OUT": "COL", "CONV_PAD": "min(CONV_PAD, KERNEL_SIZE_H // 2)"},
      {"IM2COL_IN": "HWC", "IM2COL_OUT": "ROW_BLOCK", "CONV_PAD": 0, "KERNEL_SIZE_H": [4, 8, 16], "CONV_STRIDE": "KERNEL_SIZE_H", "SIZE_C": "48 // KERNEL_SIZE_H", "SIZE_M": "max(SIZE_M - SIZE_M % KERNEL_SIZE_H, KERNEL_SIZE_H)", "SIZE_N": "max(SIZE_N - SIZE_N % KERNEL_SIZE_H, KERNEL_SIZE_H)"}
    ]
  }
}
